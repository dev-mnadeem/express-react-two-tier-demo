# Copy to .env next to docker-compose.yml. Every value has a default, so this
# file is optional; set at least POSTGRES_PASSWORD for anything but a demo.

POSTGRES_USER=roster
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roster

# Origin the browser uses to reach the API; baked into the client bundle.
PUBLIC_API_URL=http://localhost:8700
# Origin the API allows through CORS; where the client is served from.
CLIENT_URL=http://localhost:8701

# Insert 34 demo users on first boot.
SEED_ON_BOOT=false
LOG_LEVEL=info
