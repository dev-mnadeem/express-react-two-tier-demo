{
  "name": "fitco-users-api",
  "version": "1.0.0",
  "description": "Express + Sequelize REST API for the Fitco user-management take-home.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "test": "cross-env NODE_ENV=test DB_DIALECT=memory BCRYPT_ROUNDS=4 node --test \"tests/**/*.test.js\"",
    "test:watch": "cross-env NODE_ENV=test DB_DIALECT=memory BCRYPT_ROUNDS=4 node --test --watch \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.14.0",
    "moment": "^2.31.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2"
  }
}
